{
  "name": "@forge-ahead/triggers",
  "version": "0.1.0",
  "private": true,
  "description": "TypeScript contracts and utilities for Atlassian Forge triggers.",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./lifecycle": {
      "import": {
        "types": "./dist/lifecycle.d.mts",
        "default": "./dist/lifecycle.mjs"
      },
      "require": {
        "types": "./dist/lifecycle.d.cts",
        "default": "./dist/lifecycle.cjs"
      }
    },
    "./product": {
      "import": {
        "types": "./dist/product.d.mts",
        "default": "./dist/product.mjs"
      },
      "require": {
        "types": "./dist/product.d.cts",
        "default": "./dist/product.cjs"
      }
    },
    "./scheduled": {
      "import": {
        "types": "./dist/scheduled.d.mts",
        "default": "./dist/scheduled.mjs"
      },
      "require": {
        "types": "./dist/scheduled.d.cts",
        "default": "./dist/scheduled.cjs"
      }
    },
    "./webtrigger": {
      "import": {
        "types": "./dist/webtrigger.d.mts",
        "default": "./dist/webtrigger.mjs"
      },
      "require": {
        "types": "./dist/webtrigger.d.cts",
        "default": "./dist/webtrigger.cjs"
      }
    }
  },
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "typesVersions": {
    "*": {
      "lifecycle": [
        "dist/lifecycle.d.cts"
      ],
      "product": [
        "dist/product.d.cts"
      ],
      "scheduled": [
        "dist/scheduled.d.cts"
      ],
      "webtrigger": [
        "dist/webtrigger.d.cts"
      ]
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "changelog": "touch CHANGELOG.md && git cliff --offline --unreleased --prepend CHANGELOG.md",
    "check": "lefthook run pre-push --force",
    "clean": "rm -rf ./node_modules ./dist",
    "dev": "tsdown --watch",
    "format": "biome format --write",
    "format:check": "biome format",
    "lint": "lefthook run lint",
    "lint:check": "biome lint",
    "lint:fix": "biome lint --write",
    "prepare": "npm run build && (lefthook install || true)",
    "release:prepare": "scripts/release-prepare.sh",
    "test": "vitest run",
    "test:consumer": "tsc -p test/consumer/tsconfig.json",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest watch",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@forge-ahead/errors": "github:ibuchanan/forge-ahead-errors",
    "@forge-ahead/logging": "github:ibuchanan/forge-ahead-logging",
    "@forge/api": "^8.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.4",
    "@types/node": "22",
    "lefthook": "^2.1",
    "tsdown": "^0.22",
    "typescript": "^5.9",
    "vitest": "^4.1"
  },
  "engines": {
    "node": ">=22"
  }
}
